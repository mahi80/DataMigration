# Server-only configuration. Never prefix these variables with NEXT_PUBLIC_.
MIGRATION_API_URL=http://127.0.0.1:8000
MIGRATION_UI_ORIGIN=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MIGRATION_UI_SESSION_SECRET=
# Browser users sign in using their own configured backend role token.
# API tokens and database URLs do not belong in this file or a client bundle.
