{
  "spec_version": 1,
  "name": "customers-snapshot",
  "mode": "full_load_cdc",
  "workload": "oltp",
  "source": {
    "kind": "postgresql",
    "url_env": "SOURCE_URL"
  },
  "target": {
    "kind": "postgresql",
    "url_env": "TARGET_URL"
  },
  "policy": {
    "source_quiesced": true,
    "batch_size": 500,
    "max_rows_per_table": 100000,
    "target_scope": "entire_table",
    "allow_create_tables": false
  },
  "tables": [
    {
      "source": "public.customers",
      "target": "public.customers",
      "keys": [
        "customer_id"
      ],
      "columns": [
        {
          "source": "customer_id",
          "target": "customer_id",
          "data_type": "integer",
          "nullable": false
        },
        {
          "source": "customer_name",
          "target": "customer_name",
          "data_type": "string",
          "nullable": true
        }
      ]
    }
  ],
  "cloud": {
    "provider": "aws",
    "strategy": "dms_full_load_cdc",
    "state_machine_arn": "arn:aws:states:us-east-1:123456789012:stateMachine:migration-cdc-reviewed:1",
    "dms_task_arn": "arn:aws:dms:us-east-1:123456789012:task:REPLACE-TASK",
    "source_engine": "postgres",
    "target_engine": "postgres",
    "dms_preflight_report_uri": "s3://REPLACE-ME/preflight/reviewed.json",
    "source_target_reviewed": false
  }
}
